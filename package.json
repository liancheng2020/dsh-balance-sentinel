{
  "name": "dsh-balance-sentinel",
  "version": "0.1.0",
  "description": "DeepSeek 低余额主动推送到飞书/钉钉等 IM；仅限本机 DSH Desktop／本机 Web，DSH 运行期间监控；带官方账号服务的宿主免填 API Key。",
  "author": "liancheng2020",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "index.js",
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "selftest:client": "node scripts/selftest-client.mjs",
    "verify:dedup": "node scripts/verify-dedup.mjs",
    "verify:market": "node scripts/verify-market.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2+": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "keywords": [
    "deepseek",
    "balance",
    "余额",
    "低余额提醒",
    "余额提醒",
    "dsh",
    "dsh-plugin",
    "harness",
    "feishu",
    "飞书",
    "dingtalk",
    "钉钉",
    "wecom",
    "webhook",
    "alert",
    "monitor",
    "quota",
    "top-up"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liancheng2020/dsh-balance-sentinel.git"
  },
  "homepage": "https://github.com/liancheng2020/dsh-balance-sentinel"
}